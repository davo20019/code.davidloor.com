/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src https://runner.code.davidloor.com; connect-src 'self'; base-uri 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# The Next.js dynamic icon and OG image route handlers write extensionless
# files at /icon and /opengraph-image. Force the right content type so
# browsers and social cards recognize them.
/icon
  Content-Type: image/png
  Cache-Control: public, max-age=86400

/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400

/twitter-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400
